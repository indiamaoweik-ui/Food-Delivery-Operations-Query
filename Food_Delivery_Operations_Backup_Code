-- View orders table
select * 
from orders

-- Q1 What is the total revenue generated so far
select sum(total_amount) as "Total Revenue"
from orders

-- Q2 What top 5 restaurants have the highest ratings
select restaurant_name, restaurant_rating
from restaurants
order by restaurant_rating desc
limit 5

-- Q3 Which food items are ordered the most
select 
item_name, sum(quantity) as "Total Quantity Ordered"
from order_items
group by item_name
order by "Total Quantity Ordered" desc
limit 6

-- Q4 Top 3 cities generating the highest total revenue
select city, sum(total_amount) as revenue
from restaurants r  
join orders o on r.restaurant_id = o.restaurant_id
group by city
order by revenue desc
limit 3

-- Q5 Which restaurants generated the most revenue
select restaurant_name, sum(total_amount) as revenue
from restaurants r  
join orders o on r.restaurant_id = o.restaurant_id
group by restaurant_name
order by revenue desc

-- Q6 Which riders completed the highest number of deliveries
select rider_id, count(order_id) as "number of deliveries,"
from orders
where delivery_status = 'Delivered' 
group by rider_id

-- Q7 What is the average delivery time by city?
select city, avg(delivery_time_minutes) as "average delivery time in minutes"
from restaurants r  
join orders o on r.restaurant_id = o.restaurant_id
group by city
order by "average delivery time in minutes" desc

-- Q8 Which loyalty tier contributes the highest revenue?
select loyalty_tier, sum(total_amount) as revenue
from customers c  
join orders o on c.customer_id = o.customer_id
group by loyalty_tier
order by revenue desc

-- Q9 What restaurants have the highest average service fees?
select restaurant_name, avg(service_fee) as "average service fee"
from restaurants r  
join orders o on r.restaurant_id = o.restaurant_id
group by restaurant_name
order by "average service fee" desc

-- Q10 What restaurants have over 100 complaints?
select restaurant_name, count(order_id) as "number of complaints"
from restaurants r  
left join orders o on r.restaurant_id = o.restaurant_id
where complaint_flag = 'Yes'
group by restaurant_name
having count(order_id) > 100
order by "number of complaints" desc

-- Q11 Which customers placed completed orders in Lagos and spent more than 50,00 Naira in total?
select c.customer_id, customer_name, count(order_id) as "number of orders", sum(total_amount) as "total amount spent"
from customers c
left join orders o on c.customer_id = o.customer_id
where c.city = 'Lagos' and o.order_status = 'Completed'
group by 1, 2
having sum(total_amount) > 50000
